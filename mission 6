def end_game(play_again):
    """Restarts the game or closes the window."""
    global player_row, player_col, attack, shield, gold, level

    if play_again:
        player_row = 0
        player_col = 0
        attack = 5
        shield = 0
        gold = 0
        level = 1
        make_map()
        draw()
    else:
        root.destroy()


